   "source": [
    "#program to count character frequency in a string\n",
    "name=\"Parimala\"\n",
    "frequency={}\n",
    "for ch in name:\n",
    "    if ch in frequency:\n",
    "        frequency[ch]+=1\n",
    "    else:\n",
    "        frequency[ch]=1\n",
    "print(frequency)"
   ]
