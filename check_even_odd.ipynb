    "#program to find the number is even or odd using function\n",
    "def even_odd(a):\n",
    "    if a%2==0:\n",
    "        print(\"The number is even\")\n",
    "    else:\n",
    "        print(\"The number is odd\")\n",
    "a=int(input(\"enter a:\"))\n",
    "even_odd(a)"
   ]
